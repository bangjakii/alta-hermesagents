# =====================================================================
# alta-hermesagents — konfigurasi boot script
# =====================================================================
# TIDAK ADA rahasia di file ini. Kredensial provider LLM, token Telegram,
# dan password database diambil dari Infisical lalu ditulis ke .env
# masing-masing profile Hermes (~/.hermes/profiles/<nama>/.env), bukan ke
# sini. Yang ada di bawah hanya alamat dan jalur.
# =====================================================================

# Koneksi ke alta-database. Boot script MEMBACA desired state dari sini;
# `alta-hermes sync` juga MENULIS (sebagai actor human/founder, teraudit).
ALTA_DATABASE_URL=postgresql://alta:PASSWORD_DARI_INFISICAL@127.0.0.1:5432/alta

# Akar profile Hermes. Instalasi root-mode di VPS memakai /root/.hermes/profiles.
# Di mesin pengembangan Windows, instalasi Hermes memakai HERMES_HOME sendiri:
#   HERMES_PROFILES_ROOT=C:/Users/<user>/AppData/Local/hermes/profiles
# Profile ALTA (alta-*) menumpang instalasi yang sama dengan profile KS (ks-*);
# tiap profile punya .env, memori, sesi, dan kredensial sendiri.
HERMES_PROFILES_ROOT=/root/.hermes/profiles

# Lokasi repo alta-database di VPS — dipakai untuk menjalankan MCP Server.
ALTA_BACKEND_DIR=/opt/alta/alta-database/backend

# Perintah yang menyalakan satu proses MCP. Kosongkan untuk memakai default:
#   <ALTA_BACKEND_DIR>/.venv/bin/alta-mcp     (tanpa argumen)
#
# JANGAN memakai `uv run alta-mcp` di sini meski README backend menyebutnya:
# `uv run` menyelaraskan ulang venv terhadap pyproject setiap kali dipanggil.
# Pada uji 6 Agustus 2026 ia menaikkan `mcp` ke versi mayor yang tidak lagi
# punya `mcp.server.fastmcp`, dan server MCP mati saat start. Sembilan proses
# yang menyelaraskan dependensi setiap boot juga membuat startup bergantung
# pada jaringan.
#
# ALTA_AGENT disuntikkan boot script per departemen, jangan ditulis di sini.
# Untuk mencoba di Windows, arahkan ke berkas .exe-nya:
#   ALTA_MCP_COMMAND=C:/.../backend/.venv/Scripts/alta-mcp.exe
ALTA_MCP_COMMAND=
ALTA_MCP_ARGS=

# Awalan nama profile Hermes bila agents.profile_name di DB masih kosong.
ALTA_PROFILE_PREFIX=alta-
